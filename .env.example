# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Backend Configuration
APP_ENV=development
APP_SECRET=change_this_to_a_random_32_character_string
ALLOWED_ORIGIN=http://localhost:3000

# Database Configuration (MariaDB / MySQL or local SQLite for testing)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aromatica_db
DB_USER=aromatica_user
DB_PASS=secret_db_password

# For local development with SQLite fallback if MySQL is not available:
# DB_DRIVER=sqlite
# DB_FILE=database/app.sqlite

# Media Uploads Configuration
UPLOAD_DIR=../uploads
MAX_UPLOAD_SIZE_MB=50
